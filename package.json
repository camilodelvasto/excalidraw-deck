{
  "name": "excalidraw-deck",
  "version": "0.1.0",
  "description": "Slides as data on one Excalidraw canvas — dev, build, deploy to GitHub or Codeberg Pages.",
  "type": "module",
  "license": "MIT",
  "author": "Camilo Delvasto",
  "repository": "github:camilodelvasto/excalidraw-deck",
  "bin": {
    "excalidraw-deck": "bin/deck.js"
  },
  "types": "./deck.d.ts",
  "exports": {
    ".": {
      "types": "./deck.d.ts"
    }
  },
  "files": [
    "bin",
    "app",
    "src",
    "schemas",
    "examples/showcase/slides.js",
    "examples/showcase/deck.yaml",
    "examples/showcase/media",
    "deck.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:browser": "node --test test/browser/*.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^6.4.4",
    "yaml": "^2.8.0"
  }
}
