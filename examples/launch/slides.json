              "color": "lemon",
              "angle": -3,
              "step": 2
            },
            {
              "t": "text",
              "x": 120,
              "y": 990,
              "fs": 26,
              "text": "excalidraw-deck · npx excalidraw-deck dev",
              "font": "mono",
              "color": "grey"
            }
          ]
        }
      ]
    },
    {
