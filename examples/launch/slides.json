              "t": "box",
              "x": 120,
              "y": 700,
              "w": 760,
              "h": 130,
              "fs": 34,
              "text": "color: 'acid'",
              "font": "mono",
              "color": "acid",
              "fill": "pattern",
              "step": 2
            },
            {
              "t": "text",
              "x": 940,
              "y": 740,
              "fs": 34,
