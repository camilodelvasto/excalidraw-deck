            {
              "t": "text",
              "x": 120,
              "y": 790,
              "fs": 40,
              "text": "every slide is a 1920×1080 frame on one infinite canvas;\nnavigation is a camera flight, not a page swap",
              "font": "sans",
              "step": 1
            }
          ]
        },
        {
          "name": "see it whole",
          "col": 1,
          "via": "overview",
          "items": [
            {
              "t": "text",
              "x": 120,
              "y": 110,
              "fs": 72,
              "text": "one canvas, really",
              "font": "display"
            },
            {
              "t": "text",
              "x": 120,
              "y": 320,
              "fs": 40,
              "text": "this slide declared  via: 'overview'  —\nto get here, the camera flew out over the whole talk first",
              "font": "sans"
            },
            {
              "t": "text",
              "x": 120,
              "y": 620,
              "fs": 36,
              "text": "that zoom-out you just watched\nwas the overview",
              "font": "hand",
              "color": "amber",
              "angle": -2,
              "step": 1
            },
            {
              "t": "text",
              "x": 120,
              "y": 920,
              "fs": 28,
              "text": "{ name: 'see it whole', col: 1, via: 'overview' }",
              "font": "mono",
              "color": "grey"
            }
          ]
        }
      ]
    },
    {
      "name": "write",
      "slides": [
        {
          "name": "slides are data",
          "col": 0,
          "items": [
            {
              "t": "text",
              "x": 120,
              "y": 110,
              "fs": 72,
              "text": "slides are data",
              "font": "display"
            },
            {
              "t": "text",
              "x": 120,
              "y": 280,
              "fs": 30,
              "text": "{\n  t: 'note',\n  x: 1180, y: 420,\n  size: 300, fs: 40,\n  text: 'hello',\n  color: 'yellow',\n  step: 1,\n}",
              "font": "mono"
            },
            {
              "t": "note",
              "x": 1180,
              "y": 420,
              "size": 300,
              "fs": 40,
              "text": "hello",
              "color": "yellow",
              "step": 1
            },
            {
              "t": "arrow",
              "from": [
                700,
                440
              ],
              "to": [
                1130,
                540
              ],
              "color": "grey",
              "dash": "dashed",
              "text": "renders as",
              "fs": 28,
              "step": 2
            },
            {
              "t": "text",
              "x": 120,
              "y": 820,
              "fs": 40,
              "text": "no builder API, no export pipeline — the file is the deck;\nhelpers are plain JavaScript",
              "font": "sans",
              "step": 2
            }
          ]
        },
        {
          "name": "nothing fails silently",
          "col": 1,
          "items": [
            {
              "t": "text",
              "x": 120,
              "y": 110,
              "fs": 72,
              "text": "check: the agent loop",
              "font": "display"
            },
            {
              "t": "text",
              "x": 120,
              "y": 300,
              "fs": 40,
              "text": "the format is typed and validated — an unknown key,\ncolor, or font throws; nothing defaults silently",
              "font": "sans"
            },
            {
              "t": "box",
              "x": 120,
              "y": 520,
              "w": 760,
              "h": 130,
              "fs": 34,
              "text": "color: 'perrywinkle'",
              "font": "mono",
              "color": "coral",
              "fill": "pattern",
              "step": 1
