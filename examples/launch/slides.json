{
  "$schema": "https://raw.githubusercontent.com/camilodelvasto/excalidraw-deck/main/schemas/slides.schema.json",
  "takes": [
    {
      "name": "open",
      "slides": [
        {
          "name": "cold open",
          "col": 0,
          "items": [
            {
              "t": "plate",
              "color": "night"
            },
            {
              "t": "text",
              "x": 160,
              "y": 300,
              "fs": 104,
              "text": "a talk is a drawing\nwith a camera",
              "align": "middle",
              "w": 1600,
              "font": "display",
              "color": "paper"
            },
            {
              "t": "text",
              "x": 160,
              "y": 660,
              "fs": 40,
              "text": "this entire deck is one Excalidraw canvas\nand one JavaScript file",
